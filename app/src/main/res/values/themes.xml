<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Harmoid" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- 系统栏透明：内容边到边，由页面自己（玻璃顶栏 / 底栏）决定避让 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <!-- 刘海 / 挖孔区域也允许内容铺开，交给 HAP 自行避让 -->
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="27">shortEdges</item>
    </style>

    <!-- 关于页独立 Activity：窗口背景直接给底色，避免启动瞬间闪白/闪黑 -->
    <style name="Theme.Harmoid.About" parent="Theme.Harmoid">
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@color/about_window_bg</item>
    </style>

</resources>
